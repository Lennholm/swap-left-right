{
  "manifest_version": 3,
  "name": "Swap left-right",
  "version": "1.0",
  "description": "Context menu item for swapping the left and right parts of images on Facebook",
  "icons": {
    "32": "icon-32.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "*://www.facebook.com/*"
  ],
  "background": {
    "scripts": [ "background.js" ],
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "swaplr@lennholm",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "142.0"
    }
  }
}